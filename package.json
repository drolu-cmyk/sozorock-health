{
  "name": "sozorock-health",
  "private": true,
  "version": "0.1.0",
  "description": "Nationwide non-clinical health, workforce-readiness, and public-systems infrastructure for SozoRock Health.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "brace-expansion@<2.0.0": "1.1.21",
    "brace-expansion@>=4.0.0 <6.0.0": "5.0.12",
    "fast-uri": "3.1.9",
    "image-size": "$image-size",
    "js-yaml": "4.3.2",
    "metro": {
      "image-size": "$image-size"
    },
    "nanoid": "3.3.18",
    "next": {
      "postcss": "$postcss"
    },
    "postcss": "$postcss",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@xmldom/xmldom@<0.9.0": "0.8.15",
    "@xmldom/xmldom@>=0.9.0 <0.9.12": "0.9.12",
    "compression": "1.8.2",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.7",
    "sharp": "0.35.5"
  },
  "resolutions": {
    "postcss": "8.5.30",
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail && node scripts/reconcile-installed-security-lock.mjs && node scripts/verify-dependency-backports.mjs",
    "dev:public": "npm exec --workspace @sozorock/public-site -- next dev",
    "build:public": "npm exec --workspace @sozorock/public-site -- next build",
    "verify:public-runtime-security": "node scripts/verify-public-runtime-security.mjs",
    "dev:platform": "npm exec --workspace @sozorock/platform -- next dev",
    "build:platform": "npm exec --workspace @sozorock/platform -- next build",
    "refresh:cbcap-data": "node scripts/refresh-cbcap-data.mjs && node scripts/build-cbcap-runtime-data.mjs",
    "build:cbcap-runtime-data": "node scripts/build-cbcap-runtime-data.mjs",
    "refresh:cbcap-geometries": "node scripts/refresh-cbcap-geometries.mjs",
    "build:partner-evidence-review": "npm run build:partner-evidence-review --workspace @sozorock/evidence-core",
    "start:mobile": "npm exec --workspace @sozorock/mobile -- expo start",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "node --test scripts/dependency-audit.test.mjs scripts/configured-aws-account.test.mjs && npm run test --workspaces --if-present",
    "prebuild:public": "node scripts/copy-maplibre-worker.mjs",
    "predev:public": "node scripts/copy-maplibre-worker.mjs",
    "audit:production": "node scripts/audit-production-dependencies.mjs",
    "verify:dependency-backports": "node scripts/verify-dependency-backports.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "image-size": "file:vendor/image-size",
    "patch-package": "^8.0.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "8.5.30"
  }
}
