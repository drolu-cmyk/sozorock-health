          "repo:drolu-cmyk/sozorock-health:environment:production"
        ],
        "token.actions.githubusercontent.com:job_workflow_ref": [
          "drolu-cmyk/sozorock-health/.github/workflows/deploy.yml@refs/heads/main",
          "drolu-cmyk/sozorock-health/.github/workflows/explore-production.yml@refs/heads/main",
          "drolu-cmyk/sozorock-health/.github/workflows/milestone-10-staging.yml@refs/heads/codex/explore-agentic-collaboration"
        ]
      }
    }
  }]
